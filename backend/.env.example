# Copy to .env for local development. Keep real credentials out of source control.
PORT=4000
# Optional. Replace with a valid key or leave blank for rule-based voice intents.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
# Set a private PIN for the conductor dashboard; never use this example value.
CONDUCTOR_PIN=replace-with-a-private-pin
